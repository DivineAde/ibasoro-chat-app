# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Cloudinary (unsigned uploads) – used for profile photos.
# Defaults to the project's existing values if left unset.
# VITE_CLOUDINARY_CLOUD_NAME=dflgmfevw
# VITE_CLOUDINARY_UPLOAD_PRESET=chat-app

# Photos, files and voice notes are signed by the API when it has CLOUDINARY_* set
# (see the backend .env.example). The unsigned preset above is only the fallback.
