+import { LogoMark } from "../../components/ui/Logo";
+
+/** Right-hand pane on desktop when no chat is open. */
+export function EmptyConversation() {
+  return (
+    <div className="chat-pattern flex h-full flex-col items-center justify-center gap-4 px-8 text-center">
+      <LogoMark size={56} />
+      <div>
+        <h2 className="text-title2 text-ink">Pick a conversation</h2>
+        <p className="mt-1 max-w-[30ch] text-subhead text-ink-2">
+          Choose a chat from the list, or start a new one with the pencil button.
+        </p>
+      </div>
+    </div>
+  );
+}
diff --git a/src/features/chat/GroupInfoDialog.jsx b/src/features/chat/GroupInfoDialog.jsx
new file mode 100644
index 0000000..1c18f29
--- /dev/null
+++ b/src/features/chat/GroupInfoDialog.jsx
@@ -0,0 +1,147 @@
+import { useEffect, useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { Crown, LogOut, UserMinus, UserPlus } from "lucide-react";
+import { Dialog } from "../../components/ui/Dialog";
+import { Button } from "../../components/ui/Button";
+import { Input } from "../../components/ui/Input";
+import { IconButton } from "../../components/ui/IconButton";
+import { Avatar } from "../../components/ui/Avatar";
+import { useToast } from "../../components/ui/Toast";
+import { errorMessage } from "../../lib/api";
+import { useAuth } from "../../context/AuthContext";
+import { useChatActions } from "../../context/ChatContext";
+import { addMember, leaveGroup, removeMember, renameGroup } from "./chatApi";
+import { UserSearch } from "./UserSearch";
+
+/** Group details. Admins can rename, add and remove people; everyone can leave. */
+export function GroupInfoDialog({ open, onClose, chat }) {
+  const { user: me } = useAuth();
+  const { upsertChat, removeChat } = useChatActions();
+  const toast = useToast();
+  const navigate = useNavigate();
+  const [name, setName] = useState(chat.chatName);
+  const [adding, setAdding] = useState(false);
+  const [query, setQuery] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  // Follow renames made by someone else while this is open.
+  useEffect(() => setName(chat.chatName), [chat.chatName]);
+
+  const adminId = chat.groupAdmin?._id;
+  const isAdmin = adminId === me._id;
+
+  const run = async (action, failure) => {
+    setBusy(true);
+    try {
+      return await action();
+    } catch (error) {
+      toast.error(failure, errorMessage(error));
+      return null;
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const saveName = async () => {
+    const next = name.trim();
+    if (!next || next === chat.chatName) return setName(chat.chatName);
+    const updated = await run(() => renameGroup(chat._id, next), "Couldn’t rename the group");
+    if (updated) upsertChat(updated);
+  };
+
+  const add = async (user) => {
+    const updated = await run(() => addMember(chat._id, user._id), "Couldn’t add that person");
+    if (updated) {
+      upsertChat(updated);
+      setAdding(false);
+      setQuery("");
+      toast.success(`${user.name} added`);
+    }
+  };
+
+  const remove = async (user) => {
+    const updated = await run(() => removeMember(chat._id, user._id), "Couldn’t remove that person");
+    if (updated) upsertChat(updated);
+  };
+
+  const leave = async () => {
+    const result = await run(() => leaveGroup(chat._id), "Couldn’t leave the group");
+    if (result) {
+      onClose();
+      removeChat(chat._id);
+      navigate("/chat", { replace: true });
+    }
+  };
+
+  return (
+    <Dialog open={open} onClose={onClose} title="Group info">
+      <div className="space-y-6">
+        <div className="flex flex-col items-center gap-3">
+          <Avatar name={chat.chatName} group size="xl" />
+          {isAdmin ? (
+            <Input
+              aria-label="Group name"
+              value={name}
+              maxLength={60}
+              disabled={busy}
+              onChange={(e) => setName(e.target.value)}
+              onBlur={saveName}
+              onKeyDown={(e) => e.key === "Enter" && e.currentTarget.blur()}
+              className="w-full"
+              inputClassName="text-center font-semibold"
+            />
+          ) : (
+            <h3 className="text-title2 text-ink">{chat.chatName}</h3>
+          )}
+        </div>
+
+        <section aria-labelledby="members-heading">
+          <div className="mb-1 flex items-center justify-between px-1">
+            <h3 id="members-heading" className="text-footnote font-semibold uppercase tracking-wide text-ink-3">
+              {chat.users.length} members
+            </h3>
+            {isAdmin && (
+              <Button size="sm" variant="ghost" icon={UserPlus} onClick={() => setAdding((a) => !a)}>
+                {adding ? "Done" : "Add"}
+              </Button>
+            )}
+          </div>
+
+          {adding && (
+            <div className="mb-3 rounded-[16px] bg-sunken p-3">
+              <UserSearch autoFocus query={query} onQueryChange={setQuery} onSelect={add} excludeIds={chat.users.map((u) => u._id)} />
+            </div>
+          )}
+
+          <ul className="divide-y divide-line">
+            {chat.users.map((u) => (
+              <li key={u._id} className="flex min-h-[60px] items-center gap-3 px-1 py-2">
+                <Avatar name={u.name} src={u.pic} size="sm" />
+                <div className="min-w-0 flex-1">
+                  <p className="truncate text-subhead font-semibold text-ink">
+                    {u.name}
+                    {u._id === me._id && <span className="font-normal text-ink-3"> (you)</span>}
+                  </p>
+                  <p className="truncate text-footnote text-ink-2">{u.email}</p>
+                </div>
+                {u._id === adminId ? (
+                  <span className="flex items-center gap-1 rounded-full bg-accent-soft px-2.5 py-1 text-caption font-semibold text-accent-ink">
+                    <Crown size={12} aria-hidden /> Admin
+                  </span>
+                ) : (
+                  isAdmin && (
+                    <IconButton label={`Remove ${u.name}`} icon={UserMinus} size="sm" disabled={busy} onClick={() => remove(u)} />
+                  )
+                )}
+              </li>
+            ))}
+          </ul>
+        </section>
+
+        <Button variant="danger" icon={LogOut} className="w-full" onClick={leave} disabled={busy}>
+          Leave group
+        </Button>
+      </div>
+    </Dialog>
+  );
+}
diff --git a/src/features/chat/MessageBubble.jsx b/src/features/chat/MessageBubble.jsx
new file mode 100644
index 0000000..fa4923b
--- /dev/null
+++ b/src/features/chat/MessageBubble.jsx
@@ -0,0 +1,119 @@
+import { memo } from "react";
+import { AlertCircle, Check, CheckCheck, Clock } from "lucide-react";
+import { cn } from "../../lib/cn";
+import { formatTime } from "../../lib/format";
+import { linkify } from "../../lib/linkify";
+import { Avatar } from "../../components/ui/Avatar";
+
+function Status({ message, read }) {
+  if (message.status === "sending") {
+    return <Clock size={13} aria-label="Sending" className="opacity-80" />;
+  }
+  if (message.status === "failed") {
+    return <AlertCircle size={14} aria-label="Failed to send" className="text-danger" />;
+  }
+  return read ? (
+    <CheckCheck size={15} aria-label="Read" className="text-white" />
+  ) : (
+    <Check size={14} aria-label="Sent" className="opacity-80" />
+  );
+}
+
+function Text({ content, mine }) {
+  return linkify(content).map((part, i) =>
+    part.type === "link" ? (
+      <a
+        key={i}
+        href={part.value}
+        target="_blank"
+        rel="noopener noreferrer"
+        className={cn("break-all underline underline-offset-2", mine ? "decoration-white/60" : "text-accent-ink decoration-accent-ink/40")}
+      >
+        {part.value}
+      </a>
+    ) : (
+      <span key={i}>{part.value}</span>
+    )
+  );
+}
+
+/**
+ * One chat bubble. Memoised: in a long conversation only the bubble whose
+ * props changed re-renders when a message arrives or a receipt flips.
+ */
+export const MessageBubble = memo(function MessageBubble({
+  message,
+  mine,
+  position,
+  showAvatar,
+  showName,
+  isGroup,
+  read,
+  animate,
+  onRetry,
+  onDiscard,
+}) {
+  const tail = position === "single" || position === "last";
+  const failed = message.status === "failed";
+  const sender = message.sender;
+
+  return (
+    <li
+      className={cn(
+        "flex items-end gap-2",
+        mine ? "justify-end" : "justify-start",
+        position === "single" || position === "first" ? "mt-3" : "mt-0.5",
+        animate && "animate-msg-in"
+      )}
+      style={{ transformOrigin: mine ? "bottom right" : "bottom left" }}
+    >
+      {/* Gutter keeps bubbles aligned when the avatar is only shown on the last of a run. */}
+      {isGroup && !mine && (
+        <span className="w-7 shrink-0">{showAvatar && <Avatar name={sender.name} src={sender.pic} size="xs" />}</span>
+      )}
+
+      <div className={cn("flex max-w-[min(80%,34rem)] flex-col", mine ? "items-end" : "items-start")}>
+        {isGroup && !mine && showName && (
+          <span className="mb-0.5 px-3 text-caption font-semibold text-accent-ink">{sender.name}</span>
+        )}
+
+        <div
+          className={cn(
+            "relative rounded-bubble px-3.5 py-2 text-body shadow-[0_1px_1px_rgb(var(--shadow)/0.04)]",
+            mine ? "bg-bubble-out text-accent-fg" : "bg-bubble-in text-ink ring-1 ring-inset ring-line",
+            tail && (mine ? "rounded-br-[6px]" : "rounded-bl-[6px]"),
+            message.status === "sending" && "opacity-70",
+            failed && "ring-2 ring-danger"
+          )}
+        >
+          <p className="whitespace-pre-wrap [overflow-wrap:anywhere]">
+            <Text content={message.content} mine={mine} />
+            {/* Invisible spacer reserves room so text never runs under the timestamp. */}
+            <span aria-hidden className={cn("inline-block", mine ? "w-[68px]" : "w-[50px]")} />
+          </p>
+          <span
+            className={cn(
+              "absolute bottom-1.5 right-3 flex items-center gap-1 text-[11px] tabular-nums leading-none",
+              mine ? "text-accent-fg/75" : "text-ink-3"
+            )}
+          >
+            <time dateTime={message.createdAt}>{formatTime(message.createdAt)}</time>
+            {mine && <Status message={message} read={read} />}
+          </span>
+        </div>
+
+        {failed && (
+          <div className="mt-1 flex items-center gap-3 px-1 text-footnote">
+            <span className="text-danger">Not sent.</span>
+            <button type="button" onClick={onRetry} className="font-semibold text-accent-ink hover:underline">
+              Retry
+            </button>
+            <button type="button" onClick={onDiscard} className="font-semibold text-ink-2 hover:underline">
+              Delete
+            </button>
+          </div>
+        )}
+      </div>
+    </li>
+  );
+});
diff --git a/src/features/chat/MessageBubble.test.jsx b/src/features/chat/MessageBubble.test.jsx
new file mode 100644
index 0000000..4a9e4bb
--- /dev/null
+++ b/src/features/chat/MessageBubble.test.jsx
@@ -0,0 +1,45 @@
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import { MessageBubble } from "./MessageBubble";
+
+const base = {
+  message: { _id: "m1", sender: { _id: "me", name: "Me" }, content: "hello https://example.com.", createdAt: "2024-03-05T10:00:00Z" },
+  mine: true,
+  position: "single",
+  isGroup: false,
+};
+const renderBubble = (props) => render(<ul><MessageBubble {...base} {...props} /></ul>);
+
+describe("MessageBubble", () => {
+  it("renders links safely, without the trailing full stop", () => {
+    renderBubble();
+    const link = screen.getByRole("link", { name: "https://example.com" });
+    expect(link).toHaveAttribute("rel", "noopener noreferrer");
+    expect(link).toHaveAttribute("target", "_blank");
+  });
+
+  it("shows sent vs read state", () => {
+    const { unmount } = renderBubble();
+    expect(screen.getByLabelText("Sent")).toBeInTheDocument();
+    unmount();
+    renderBubble({ read: true });
+    expect(screen.getByLabelText("Read")).toBeInTheDocument();
+  });
+
+  it("offers retry and delete for a failed message", async () => {
+    const onRetry = vi.fn();
+    const onDiscard = vi.fn();
+    renderBubble({ message: { ...base.message, status: "failed" }, onRetry, onDiscard });
+    await userEvent.click(screen.getByRole("button", { name: "Retry" }));
+    await userEvent.click(screen.getByRole("button", { name: "Delete" }));
+    expect(onRetry).toHaveBeenCalledOnce();
+    expect(onDiscard).toHaveBeenCalledOnce();
+  });
+
+  it("does not render raw HTML from message content", () => {
+    renderBubble({ message: { ...base.message, content: "<img src=x onerror=alert(1)>" } });
+    expect(document.querySelector("img")).toBeNull();
+    expect(screen.getByText(/<img src=x/)).toBeInTheDocument();
+  });
+});
diff --git a/src/features/chat/MessageList.jsx b/src/features/chat/MessageList.jsx
new file mode 100644
index 0000000..f43059c
--- /dev/null
+++ b/src/features/chat/MessageList.jsx
@@ -0,0 +1,170 @@
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { ArrowDown } from "lucide-react";
+import { buildRows, isReadByAll } from "../../lib/chat";
+import { formatDayLabel } from "../../lib/format";
+import { Spinner } from "../../components/ui/Spinner";
+import { useAuth } from "../../context/AuthContext";
+import { useChatActions } from "../../context/ChatContext";
+import { MessageBubble } from "./MessageBubble";
+import { TypingIndicator } from "./TypingIndicator";
+
+const NEAR_BOTTOM = 96; // px from the bottom that still counts as "at the bottom"
+const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+/**
+ * The scrolling transcript.
+ *  – sticks to the bottom for new messages while you're reading the latest
+ *  – otherwise leaves your position alone and offers a "new messages" jump
+ *  – loads older pages when you reach the top, without the view jumping
+ */
+export function MessageList({ chat, items, hasMore, loadingMore, typingNames }) {
+  const { user: me } = useAuth();
+  const { loadOlder, retryMessage, discardMessage } = useChatActions();
+  const scroller = useRef(null);
+  const content = useRef(null);
+  const topSentinel = useRef(null);
+  const stick = useRef(true); // are we pinned to the bottom?
+  const prev = useRef({ firstId: null, lastId: null, height: 0, top: 0, chatId: null });
+  const [showJump, setShowJump] = useState(false);
+  const [missed, setMissed] = useState(0);
+  const initialIds = useRef(new Set());
+
+  const rows = useMemo(() => buildRows(items, me._id, { formatDay: formatDayLabel }), [items, me._id]);
+
+  // Remember which messages existed when this chat was opened: only later ones animate in.
+  useEffect(() => {
+    initialIds.current = new Set(items.map((m) => m._id));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [chat._id]);
+
+  const scrollToBottom = (smooth) => {
+    const el = scroller.current;
+    el.scrollTo({ top: el.scrollHeight, behavior: smooth && !reduceMotion() ? "smooth" : "auto" });
+  };
+
+  // Keep scroll position sensible whenever the list changes.
+  useLayoutEffect(() => {
+    const el = scroller.current;
+    if (!el) return;
+    const p = prev.current;
+    const firstId = items[0]?._id;
+    const last = items[items.length - 1];
+
+    if (p.chatId !== chat._id) {
+      scrollToBottom(false); // just opened: jump to the latest, no animation
+      stick.current = true;
+      setShowJump(false);
+      setMissed(0);
+    } else if (p.firstId && firstId !== p.firstId && last?._id === p.lastId) {
+      el.scrollTop = el.scrollHeight - p.height + p.top; // older page prepended: hold the view
+    } else if (last && last._id !== p.lastId) {
+      if (stick.current || last.sender?._id === me._id) scrollToBottom(true);
+      else setMissed((n) => n + 1);
+    }
+
+    prev.current = { firstId, lastId: last?._id ?? null, height: el.scrollHeight, top: el.scrollTop, chatId: chat._id };
+  }, [items, chat._id, me._id]);
+
+  // Anything that makes the transcript taller while you're at the bottom (a failed-send
+  // row, the typing bubble, an image finishing loading) keeps the latest content in view.
+  useEffect(() => {
+    const list = content.current;
+    if (!list || typeof ResizeObserver === "undefined") return undefined;
+    const observer = new ResizeObserver(() => {
+      if (stick.current) scroller.current.scrollTop = scroller.current.scrollHeight;
+    });
+    observer.observe(list);
+    return () => observer.disconnect();
+  }, []);
+
+  // Typing bubble appearing should also reveal itself if we're pinned.
+  useLayoutEffect(() => {
+    if (typingNames.length && stick.current) scrollToBottom(true);
+  }, [typingNames.length]);
+
+  const onScroll = () => {
+    const el = scroller.current;
+    const distance = el.scrollHeight - el.scrollTop - el.clientHeight;
+    stick.current = distance < NEAR_BOTTOM;
+    setShowJump(distance > 240);
+    if (stick.current) setMissed(0);
+    prev.current.height = el.scrollHeight;
+    prev.current.top = el.scrollTop;
+  };
+
+  // Load the previous page when the top sentinel scrolls into view.
+  useEffect(() => {
+    const target = topSentinel.current;
+    if (!target || !hasMore) return undefined;
+    const io = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) {
+          const el = scroller.current;
+          prev.current.height = el.scrollHeight;
+          prev.current.top = el.scrollTop;
+          loadOlder(chat._id);
+        }
+      },
+      { root: scroller.current, rootMargin: "200px 0px 0px 0px" }
+    );
+    io.observe(target);
+    return () => io.disconnect();
+  }, [hasMore, chat._id, loadOlder, items.length]);
+
+  return (
+    <div className="relative min-h-0 flex-1">
+      <div ref={scroller} onScroll={onScroll} className="h-full overflow-y-auto overscroll-contain px-3 pb-3 pt-2 md:px-6">
+        <ul ref={content} className="mx-auto flex max-w-3xl flex-col" aria-label="Messages" aria-live="off">
+          <li ref={topSentinel} aria-hidden className="flex h-8 items-center justify-center">
+            {loadingMore && <Spinner className="text-ink-3" label="Loading earlier messages" />}
+          </li>
+
+          {!hasMore && items.length === 0 && (
+            <li className="py-16 text-center text-subhead text-ink-3">No messages yet. Say hello 👋</li>
+          )}
+
+          {rows.map((row) =>
+            row.type === "day" ? (
+              <li key={row.key} className="sticky top-1 z-[1] my-3 flex justify-center">
+                <span className="rounded-full bg-surface/90 px-3 py-1 text-caption font-semibold text-ink-2 shadow-raised ring-1 ring-inset ring-line backdrop-blur-md">
+                  {row.label}
+                </span>
+              </li>
+            ) : (
+              <MessageBubble
+                key={row.key}
+                message={row.message}
+                mine={row.mine}
+                position={row.position}
+                showAvatar={row.showAvatar}
+                showName={row.showName}
+                isGroup={chat.isGroupChat}
+                read={row.mine && isReadByAll(row.message, chat, me._id)}
+                animate={!initialIds.current.has(row.message._id)}
+                onRetry={() => retryMessage(chat._id, row.message._id)}
+                onDiscard={() => discardMessage(chat._id, row.message._id)}
+              />
+            )
+          )}
+
+          {typingNames.length > 0 && (
+            <TypingIndicator label={`${typingNames.join(", ")} ${typingNames.length > 1 ? "are" : "is"} typing`} />
+          )}
+        </ul>
+      </div>
+
+      {/* Jump to latest */}
+      <button
+        type="button"
+        onClick={() => scrollToBottom(true)}
+        aria-label={missed ? `Jump to latest, ${missed} new` : "Jump to latest"}
+        tabIndex={showJump ? 0 : -1}
+        className="press glass absolute bottom-3 right-4 flex h-11 items-center gap-1.5 rounded-full px-3.5 text-footnote font-semibold text-ink shadow-overlay transition-[opacity,transform] duration-200 ease-out data-[hidden=true]:pointer-events-none data-[hidden=true]:translate-y-2 data-[hidden=true]:opacity-0"
+        data-hidden={!showJump}
+      >
+        <ArrowDown size={16} aria-hidden />
+        {missed > 0 && <span className="tabular-nums text-accent-ink">{missed} new</span>}
+      </button>
+    </div>
+  );
+}
diff --git a/src/features/chat/NewChatDialog.jsx b/src/features/chat/NewChatDialog.jsx
new file mode 100644
