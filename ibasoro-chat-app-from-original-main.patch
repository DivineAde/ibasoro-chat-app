@@ -0,0 +1,68 @@
+import { Link } from "react-router-dom";
+import { cn } from "../../lib/cn";
+import { Avatar } from "../../components/ui/Avatar";
+import { CountBadge } from "../../components/ui/Badge";
+import { chatPicture, chatPreview, chatTitle, getOtherUser } from "../../lib/chat";
+import { formatListTime } from "../../lib/format";
+import { useAuth } from "../../context/AuthContext";
+import { useChatState } from "../../context/ChatContext";
+
+export function ChatListItem({ chat, active, index }) {
+  const { user: me } = useAuth();
+  const { online, typing } = useChatState();
+
+  const title = chatTitle(chat, me);
+  const other = !chat.isGroupChat ? getOtherUser(chat, me) : null;
+  const isOnline = other && online[other._id];
+  const typers = Object.entries(typing[chat._id] || {}).filter(([id]) => id !== me._id);
+  const preview = chatPreview(chat, me);
+  const unread = chat.unreadCount > 0;
+
+  return (
+    <li
+      className="animate-list-in"
+      // A light stagger on first paint only; capped so long lists don't feel slow.
+      style={{ animationDelay: `${Math.min(index, 8) * 24}ms` }}
+    >
+      <Link
+        to={`/chat/${chat._id}`}
+        aria-current={active ? "page" : undefined}
+        className={cn(
+          "press mx-2 flex min-h-[72px] items-center gap-3 rounded-[16px] px-3 py-2.5",
+          active ? "bg-accent-soft" : "hover:bg-ink/5"
+        )}
+      >
+        <Avatar
+          name={title}
+          src={chatPicture(chat, me)}
+          group={chat.isGroupChat}
+          online={isOnline}
+          ringClass={active ? "ring-accent-soft" : "ring-surface"}
+        />
+        <span className="min-w-0 flex-1">
+          <span className="flex items-baseline justify-between gap-2">
+            <span className={cn("truncate text-subhead text-ink", unread ? "font-bold" : "font-semibold")}>{title}</span>
+            <time
+              dateTime={chat.latestMessage?.createdAt}
+              className={cn("shrink-0 text-caption tabular-nums", unread ? "font-semibold text-accent-ink" : "text-ink-3")}
+            >
+              {formatListTime(chat.latestMessage?.createdAt)}
+            </time>
+          </span>
+          <span className="mt-0.5 flex items-center justify-between gap-2">
+            {typers.length ? (
+              <span className="truncate text-footnote font-medium text-accent-ink">
+                {chat.isGroupChat ? `${typers[0][1].split(" ")[0]} is typing…` : "typing…"}
+              </span>
+            ) : preview ? (
+              <span className={cn("truncate text-footnote", unread ? "font-medium text-ink" : "text-ink-2")}>{preview}</span>
+            ) : (
+              <span className="truncate text-footnote italic text-ink-3">No messages yet</span>
+            )}
+            <CountBadge count={chat.unreadCount} />
+          </span>
+        </span>
+      </Link>
+    </li>
+  );
+}
diff --git a/src/features/chat/ChatView.jsx b/src/features/chat/ChatView.jsx
new file mode 100644
index 0000000..a450df4
--- /dev/null
+++ b/src/features/chat/ChatView.jsx
@@ -0,0 +1,140 @@
+import { useEffect, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import { MessageCircleOff } from "lucide-react";
+import { Button } from "../../components/ui/Button";
+import { EmptyState } from "../../components/ui/EmptyState";
+import { Skeleton } from "../../components/ui/Skeleton";
+import { useAuth } from "../../context/AuthContext";
+import { useActiveChat, useChatActions, useChatState } from "../../context/ChatContext";
+import { getOtherUser } from "../../lib/chat";
+import { ChatHeader } from "./ChatHeader";
+import { Composer } from "./Composer";
+import { GroupInfoDialog } from "./GroupInfoDialog";
+import { MessageList } from "./MessageList";
+import { ProfileDialog } from "./ProfileDialog";
+
+function TranscriptSkeleton() {
+  const rows = [
+    ["start", "w-48"],
+    ["start", "w-64"],
+    ["end", "w-40"],
+    ["end", "w-56"],
+    ["start", "w-52"],
+    ["end", "w-44"],
+  ];
+  return (
+    <div className="flex-1 space-y-3 overflow-hidden px-4 pt-6" aria-hidden>
+      {rows.map(([side, width], i) => (
+        <div key={i} className={side === "end" ? "flex justify-end" : "flex justify-start"}>
+          <Skeleton className={`h-10 ${width} rounded-bubble`} />
+        </div>
+      ))}
+    </div>
+  );
+}
+
+/** One open conversation: header, transcript, composer, details dialogs. */
+export function ChatView() {
+  const { user: me } = useAuth();
+  const chat = useActiveChat();
+  const { activeChatId, chatsStatus, messages, typing } = useChatState();
+  const { loadChats, loadMessages, markRead } = useChatActions();
+  const [infoOpen, setInfoOpen] = useState(false);
+
+  const entry = messages[activeChatId];
+  const unread = chat?.unreadCount || 0;
+  const unreadRef = useRef(unread);
+  unreadRef.current = unread;
+
+  // Fetch history when the chat opens, or after a reconnect cleared the cache.
+  const hasChat = Boolean(chat);
+  const hasEntry = Boolean(entry);
+  useEffect(() => {
+    if (hasChat && !hasEntry) loadMessages(activeChatId);
+  }, [activeChatId, hasChat, hasEntry, loadMessages]);
+
+  // Opening the chat reads it; so does coming back to a tab with unread messages.
+  useEffect(() => {
+    if (unread > 0 && !document.hidden) markRead(activeChatId);
+  }, [activeChatId, unread, markRead]);
+  useEffect(() => {
+    const onVisible = () => {
+      if (!document.hidden && unreadRef.current > 0) markRead(activeChatId);
+    };
+    document.addEventListener("visibilitychange", onVisible);
+    return () => document.removeEventListener("visibilitychange", onVisible);
+  }, [activeChatId, markRead]);
+
+  // Close details when switching conversation.
+  useEffect(() => setInfoOpen(false), [activeChatId]);
+
+  const shell = "flex h-full min-h-0 flex-col bg-canvas animate-pane-in md:animate-none";
+
+  if (!chat) {
+    if (chatsStatus === "idle" || chatsStatus === "loading") {
+      return (
+        <section className={shell} aria-busy="true">
+          <TranscriptSkeleton />
+        </section>
+      );
+    }
+    return (
+      <section className={shell}>
+        <EmptyState
+          className="h-full"
+          icon={MessageCircleOff}
+          title="Conversation not found"
+          description={chatsStatus === "error" ? "We couldn’t load your chats." : "It may have been removed, or you’re no longer a member."}
+          action={
+            chatsStatus === "error" ? (
+              <Button variant="secondary" onClick={loadChats}>Try again</Button>
+            ) : (
+              <Link to="/chat" className="press inline-flex h-11 items-center rounded-control bg-sunken px-5 text-subhead font-semibold text-ink">
+                Back to messages
+              </Link>
+            )
+          }
+        />
+      </section>
+    );
+  }
+
+  const typingNames = Object.entries(typing[chat._id] || {})
+    .filter(([id]) => id !== me._id)
+    .map(([, name]) => name.split(" ")[0]);
+
+  return (
+    <section className={shell} aria-label="Conversation">
+      <ChatHeader chat={chat} onOpenInfo={() => setInfoOpen(true)} />
+
+      <div className="chat-pattern flex min-h-0 flex-1 flex-col">
+        {!entry || entry.status === "loading" ? (
+          <TranscriptSkeleton />
+        ) : entry.status === "error" ? (
+          <EmptyState
+            className="flex-1"
+            title="Couldn’t load messages"
+            description="Check your connection and try again."
+            action={<Button variant="secondary" onClick={() => loadMessages(chat._id)}>Try again</Button>}
+          />
+        ) : (
+          <MessageList
+            chat={chat}
+            items={entry.items}
+            hasMore={entry.hasMore}
+            loadingMore={entry.loadingMore}
+            typingNames={typingNames}
+          />
+        )}
+      </div>
+
+      <Composer key={chat._id} chatId={chat._id} />
+
+      {chat.isGroupChat ? (
+        <GroupInfoDialog open={infoOpen} onClose={() => setInfoOpen(false)} chat={chat} />
+      ) : (
+        <ProfileDialog open={infoOpen} onClose={() => setInfoOpen(false)} user={getOtherUser(chat, me)} />
+      )}
+    </section>
+  );
+}
diff --git a/src/features/chat/Composer.jsx b/src/features/chat/Composer.jsx
new file mode 100644
index 0000000..c729e30
--- /dev/null
+++ b/src/features/chat/Composer.jsx
@@ -0,0 +1,122 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from "react";
+import { ArrowUp } from "lucide-react";
+import { cn } from "../../lib/cn";
+import { useMediaQuery } from "../../hooks/useMediaQuery";
+import { useChatActions } from "../../context/ChatContext";
+
+export const MAX_LENGTH = 4000;
+const SHOW_COUNTER_AT = 3500;
+const MAX_HEIGHT = 160; // ~6 lines
+const TYPING_IDLE_MS = 2500;
+
+// Unsent text survives switching chats (kept for the lifetime of the tab).
+const drafts = new Map();
+
+/**
+ * Message input.
+ *  – Enter sends, Shift+Enter adds a line (on touch keyboards Enter adds a line)
+ *  – grows with content, then scrolls
+ *  – tells the other side when you start / stop typing
+ * Mount with `key={chatId}` so each chat gets its own draft and typing state.
+ */
+export function Composer({ chatId }) {
+  const { sendMessage, emitTyping } = useChatActions();
+  const [text, setText] = useState(() => drafts.get(chatId) || "");
+  const field = useRef(null);
+  const typing = useRef({ on: false, timer: null });
+  const touch = useMediaQuery("(pointer: coarse)");
+
+  const canSend = text.trim().length > 0;
+
+  useLayoutEffect(() => {
+    const el = field.current;
+    el.style.height = "auto";
+    el.style.height = `${Math.min(el.scrollHeight, MAX_HEIGHT)}px`;
+  }, [text]);
+
+  const stopTyping = useCallback(() => {
+    const t = typing.current;
+    clearTimeout(t.timer);
+    if (t.on) {
+      t.on = false;
+      emitTyping(chatId, false);
+    }
+  }, [chatId, emitTyping]);
+
+  useEffect(() => stopTyping, [stopTyping]);
+
+  const onChange = (e) => {
+    const value = e.target.value;
+    setText(value);
+    if (value) drafts.set(chatId, value);
+    else drafts.delete(chatId);
+
+    const t = typing.current;
+    if (!value.trim()) return stopTyping();
+    if (!t.on) {
+      t.on = true;
+      emitTyping(chatId, true);
+    }
+    clearTimeout(t.timer);
+    t.timer = setTimeout(stopTyping, TYPING_IDLE_MS);
+  };
+
+  const send = () => {
+    if (!canSend) return;
+    sendMessage(chatId, text);
+    setText("");
+    drafts.delete(chatId);
+    stopTyping();
+    field.current?.focus();
+  };
+
+  const onKeyDown = (e) => {
+    if (e.key !== "Enter" || e.shiftKey || touch || e.nativeEvent.isComposing) return;
+    e.preventDefault();
+    send();
+  };
+
+  return (
+    <div className="glass border-t border-line px-3 pb-[calc(var(--safe-bottom)+10px)] pt-2.5 md:px-6">
+      <div className="mx-auto flex max-w-3xl items-end gap-2">
+        <div className="flex min-w-0 flex-1 items-end rounded-[22px] bg-sunken ring-1 ring-inset ring-line transition-shadow duration-160 ease-out focus-within:ring-2 focus-within:ring-accent-ink">
+          <textarea
+            ref={field}
+            rows={1}
+            value={text}
+            maxLength={MAX_LENGTH}
+            onChange={onChange}
+            onKeyDown={onKeyDown}
+            onBlur={stopTyping}
+            aria-label="Message"
+            placeholder="Message"
+            enterKeyHint={touch ? "enter" : "send"}
+            autoComplete="off"
+            className="max-h-40 min-h-[44px] min-w-0 flex-1 resize-none bg-transparent px-4 py-[11px] text-body text-ink outline-none placeholder:text-ink-3"
+          />
+          {text.length >= SHOW_COUNTER_AT && (
+            <span className={cn("pb-3 pr-3 text-caption tabular-nums", text.length >= MAX_LENGTH ? "text-danger" : "text-ink-3")}>
+              {MAX_LENGTH - text.length}
+            </span>
+          )}
+        </div>
+
+        <button
+          type="button"
+          onClick={send}
+          // Keep focus in the field so the touch keyboard doesn't collapse on every send.
+          onPointerDown={(e) => e.preventDefault()}
+          disabled={!canSend}
+          aria-label="Send message"
+          className={cn(
+            "press relative mb-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full",
+            "after:absolute after:-inset-1 after:content-['']",
+            canSend ? "bg-accent text-accent-fg shadow-raised hover:bg-accent-hover" : "bg-ink/10 text-ink-3"
+          )}
+        >
+          <ArrowUp size={20} strokeWidth={2.5} aria-hidden />
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/src/features/chat/Composer.test.jsx b/src/features/chat/Composer.test.jsx
new file mode 100644
index 0000000..cdfe0a3
--- /dev/null
+++ b/src/features/chat/Composer.test.jsx
@@ -0,0 +1,66 @@
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const actions = { sendMessage: vi.fn(), emitTyping: vi.fn() };
+vi.mock("../../context/ChatContext", () => ({ useChatActions: () => actions }));
+
+import { Composer } from "./Composer";
+
+// Drafts are remembered per chat id, so each test gets a fresh chat.
+let counter = 0;
+const setup = (chatId = `c${++counter}`) => {
+  const user = userEvent.setup();
+  render(<Composer chatId={chatId} />);
+  return { chatId, user, field: screen.getByRole("textbox", { name: "Message" }), send: screen.getByRole("button", { name: "Send message" }) };
+};
+
+beforeEach(() => {
+  actions.sendMessage.mockClear();
+  actions.emitTyping.mockClear();
+});
+
+describe("Composer", () => {
+  it("cannot send an empty or whitespace-only message", async () => {
+    const { user, field, send } = setup();
+    expect(send).toBeDisabled();
+    await user.type(field, "   ");
+    expect(send).toBeDisabled();
+    await user.keyboard("{Enter}");
+    expect(actions.sendMessage).not.toHaveBeenCalled();
+  });
+
+  it("Enter sends and clears; Shift+Enter inserts a new line instead", async () => {
+    const { chatId, user, field } = setup();
+    await user.type(field, "hello{Shift>}{Enter}{/Shift}world");
+    expect(field).toHaveValue("hello\nworld");
+    expect(actions.sendMessage).not.toHaveBeenCalled();
+
+    await user.keyboard("{Enter}");
+    expect(actions.sendMessage).toHaveBeenCalledWith(chatId, "hello\nworld");
+    expect(field).toHaveValue("");
+  });
+
+  it("the send button works too", async () => {
+    const { chatId, user, field, send } = setup();
+    await user.type(field, "hi");
+    await user.click(send);
+    expect(actions.sendMessage).toHaveBeenCalledWith(chatId, "hi");
+  });
+
+  it("announces typing once, then stops when the message is sent", async () => {
+    const { chatId, user, field } = setup();
+    await user.type(field, "abc");
+    expect(actions.emitTyping.mock.calls).toEqual([[chatId, true]]);
+    await user.keyboard("{Enter}");
+    expect(actions.emitTyping).toHaveBeenLastCalledWith(chatId, false);
+  });
+
+  it("restores an unsent draft when you come back to the chat", async () => {
+    const first = setup("draft-chat");
+    await first.user.type(first.field, "half-written");
+    document.body.innerHTML = "";
+    const { field } = setup("draft-chat");
+    expect(field).toHaveValue("half-written");
+  });
+});
