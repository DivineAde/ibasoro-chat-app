@@ -0,0 +1,30 @@
+import { act, render, screen } from "@testing-library/react";
+import { beforeEach, expect, it } from "vitest";
+import { ThemeProvider, useTheme } from "./ThemeContext";
+
+function Probe() {
+  const { preference, resolved, setPreference } = useTheme();
+  return (
+    <>
+      <p data-testid="state">{`${preference}/${resolved}`}</p>
+      <button onClick={() => setPreference("dark")}>dark</button>
+    </>
+  );
+}
+
+beforeEach(() => {
+  localStorage.clear();
+  document.documentElement.removeAttribute("data-theme");
+  document.head.innerHTML = '<meta name="theme-color" content="#f7f5f1">';
+});
+
+it("follows the system by default, and an explicit choice sets <html>, the browser chrome colour and storage", () => {
+  render(<ThemeProvider><Probe /></ThemeProvider>);
+  expect(screen.getByTestId("state")).toHaveTextContent("system/light");
+
+  act(() => screen.getByText("dark").click());
+  expect(screen.getByTestId("state")).toHaveTextContent("dark/dark");
+  expect(document.documentElement.dataset.theme).toBe("dark");
+  expect(document.querySelector('meta[name="theme-color"]').getAttribute("content")).toBe("#0e0e12");
+  expect(JSON.parse(localStorage.getItem("ibasoro:theme"))).toBe("dark");
+});
diff --git a/src/context/chatReducer.js b/src/context/chatReducer.js
new file mode 100644
index 0000000..85932d6
--- /dev/null
+++ b/src/context/chatReducer.js
@@ -0,0 +1,208 @@
+import { idOf, upsertMessage } from "../lib/chat";
+
+/**
+ * All chat state lives in one pure reducer so the real-time rules
+ * (ordering, unread counts, de-duplication, read receipts) are testable
+ * without React or a socket.
+ *
+ * state = {
+ *   chatsStatus: "idle" | "loading" | "loaded" | "error",
+ *   chats: Chat[]                       // newest activity first
+ *   messages: { [chatId]: { items, hasMore, status, loadingMore } }
+ *   typing:   { [chatId]: { [userId]: name } }
+ *   online:   { [userId]: true }
+ *   lastSeen: { [userId]: isoString }
+ * }
+ */
+export const initialChatState = {
+  chatsStatus: "idle",
+  chats: [],
+  messages: {},
+  typing: {},
+  online: {},
+  lastSeen: {},
+};
+
+const activity = (chat) => new Date(chat.latestMessage?.createdAt || chat.updatedAt || 0).getTime();
+export const sortChats = (chats) => chats.slice().sort((a, b) => activity(b) - activity(a));
+
+const patchChat = (state, chatId, patch) => ({
+  ...state,
+  chats: state.chats.map((c) => (c._id === chatId ? { ...c, ...patch(c) } : c)),
+});
+
+const patchMessages = (state, chatId, patch) => {
+  const current = state.messages[chatId];
+  if (!current) return state;
+  return { ...state, messages: { ...state.messages, [chatId]: { ...current, ...patch(current) } } };
+};
+
+export function chatReducer(state, action) {
+  switch (action.type) {
+    case "reset":
+      return initialChatState;
+
+    // ── Chat list ───────────────────────────────────────────────────────────
+    case "chats/loading":
+      return { ...state, chatsStatus: state.chatsStatus === "loaded" ? "loaded" : "loading" };
+    case "chats/error":
+      return { ...state, chatsStatus: state.chatsStatus === "loaded" ? "loaded" : "error" };
+    case "chats/loaded":
+      return { ...state, chatsStatus: "loaded", chats: sortChats(action.chats) };
+
+    case "chat/upsert": {
+      const existing = state.chats.find((c) => c._id === action.chat._id);
+      const merged = existing
+        ? {
+            ...existing,
+            ...action.chat,
+            // Broadcast payloads carry no per-user data; keep our own unread count.
+            unreadCount: action.keepUnread ? existing.unreadCount : action.chat.unreadCount ?? 0,
+            latestMessage: action.chat.latestMessage ?? existing.latestMessage,
+          }
+        : { unreadCount: 0, ...action.chat };
+      const rest = state.chats.filter((c) => c._id !== action.chat._id);
+      return { ...state, chats: sortChats([merged, ...rest]) };
+    }
+
+    case "chat/removed": {
+      const { [action.chatId]: _gone, ...messages } = state.messages;
+      return { ...state, chats: state.chats.filter((c) => c._id !== action.chatId), messages };
+    }
+
+    case "chat/markedRead":
+      return patchChat(state, action.chatId, () => ({ unreadCount: 0 }));
+
+    // ── Messages ────────────────────────────────────────────────────────────
+    case "messages/loading":
+      return {
+        ...state,
+        messages: {
+          ...state.messages,
+          [action.chatId]: { items: [], hasMore: false, status: "loading", loadingMore: false },
+        },
+      };
+    case "messages/loaded":
+      return {
+        ...state,
+        messages: {
+          ...state.messages,
+          [action.chatId]: {
+            // Server history first, then any optimistic (still sending / failed) messages.
+            items: [
+              ...action.messages,
+              ...(state.messages[action.chatId]?.items || []).filter((m) => m.status),
+            ],
+            hasMore: action.hasMore,
+            status: "loaded",
+            loadingMore: false,
+          },
+        },
+      };
+    case "messages/error":
+      return patchMessages(state, action.chatId, () => ({ status: "error" }));
+    case "messages/loadingMore":
+      return patchMessages(state, action.chatId, () => ({ loadingMore: true }));
+    case "messages/older":
+      return patchMessages(state, action.chatId, (cur) => ({
+        items: [...action.messages.filter((m) => !cur.items.some((x) => x._id === m._id)), ...cur.items],
+        hasMore: action.hasMore,
+        loadingMore: false,
+      }));
+    case "messages/loadMoreFailed":
+      return patchMessages(state, action.chatId, () => ({ loadingMore: false }));
+    case "messages/invalidate":
+      return { ...state, messages: {} };
+
+    // A message arrived from the server (socket) – or our own, echoed back.
+    case "message/received": {
+      const { message, meId, countUnread } = action;
+      const chatId = idOf(message.chat);
+      let next = state;
+
+      if (state.messages[chatId]?.status === "loaded") {
+        // Our own message echoed back carries the id of its optimistic bubble: swap it in place.
+        next = patchMessages(next, chatId, (cur) => ({
+          items: upsertMessage(
+            message.clientId ? cur.items.filter((m) => m._id !== message.clientId) : cur.items,
+            message
+          ),
+        }));
+      }
+
+      const known = state.chats.some((c) => c._id === chatId);
+      if (!known) return next;
+
+      const isNew = !state.messages[chatId]?.items?.some((m) => m._id === message._id);
+      const fromOther = idOf(message.sender) !== meId;
+      next = patchChat(next, chatId, (c) => ({
+        latestMessage: message,
+        updatedAt: message.createdAt,
+        unreadCount: c.unreadCount + (fromOther && countUnread && isNew ? 1 : 0),
+      }));
+      // They sent something, so they are no longer typing.
+      const typing = { ...next.typing[chatId] };
+      delete typing[idOf(message.sender)];
+      return { ...next, chats: sortChats(next.chats), typing: { ...next.typing, [chatId]: typing } };
+    }
+
+    case "message/optimistic":
+      return patchMessages(state, action.chatId, (cur) => ({ items: [...cur.items, action.message] }));
+    case "message/failed":
+      return patchMessages(state, action.chatId, (cur) => ({
+        items: cur.items.map((m) => (m._id === action.tempId ? { ...m, status: "failed" } : m)),
+      }));
+    case "message/retrying":
+      return patchMessages(state, action.chatId, (cur) => ({
+        items: cur.items.map((m) => (m._id === action.tempId ? { ...m, status: "sending" } : m)),
+      }));
+    case "message/discarded":
+      return patchMessages(state, action.chatId, (cur) => ({
+        items: cur.items.filter((m) => m._id !== action.tempId),
+      }));
+    case "message/replaced": {
+      const next = patchMessages(state, action.chatId, (cur) => ({
+        items: upsertMessage(
+          cur.items.filter((m) => m._id !== action.tempId),
+          action.message
+        ),
+      }));
+      return chatReducer(next, { type: "message/received", message: action.message, meId: action.meId, countUnread: false });
+    }
+
+    // Someone read the conversation: stamp them on messages they did not send.
+    case "messages/readBy": {
+      const { chatId, userId } = action;
+      const stamp = (m) =>
+        idOf(m.sender) === userId || (m.readBy || []).some((r) => idOf(r) === userId)
+          ? m
+          : { ...m, readBy: [...(m.readBy || []), userId] };
+      let next = patchMessages(state, chatId, (cur) => ({ items: cur.items.map(stamp) }));
+      next = patchChat(next, chatId, (c) => (c.latestMessage ? { latestMessage: stamp(c.latestMessage) } : {}));
+      return next;
+    }
+
+    // ── Presence & typing ───────────────────────────────────────────────────
+    case "presence/list":
+      return { ...state, online: Object.fromEntries(action.ids.map((id) => [id, true])) };
+    case "presence/update": {
+      const online = { ...state.online };
+      if (action.online) online[action.userId] = true;
+      else delete online[action.userId];
+      const lastSeen = action.lastSeenAt
+        ? { ...state.lastSeen, [action.userId]: action.lastSeenAt }
+        : state.lastSeen;
+      return { ...state, online, lastSeen };
+    }
+
+    case "typing/set": {
+      const forChat = { ...state.typing[action.chatId] };
+      if (action.on) forChat[action.userId] = action.name;
+      else delete forChat[action.userId];
+      return { ...state, typing: { ...state.typing, [action.chatId]: forChat } };
+    }
+
+    default:
+      return state;
+  }
+}
diff --git a/src/context/chatReducer.test.js b/src/context/chatReducer.test.js
new file mode 100644
index 0000000..27212c4
--- /dev/null
+++ b/src/context/chatReducer.test.js
@@ -0,0 +1,137 @@
+import { describe, expect, it } from "vitest";
+import { chatReducer, initialChatState } from "./chatReducer";
+
+const ME = "me";
+const chat = (id, extra = {}) => ({ _id: id, users: [{ _id: ME }, { _id: "bo" }], unreadCount: 0, updatedAt: "2024-01-01T00:00:00Z", ...extra });
+const msg = (id, extra = {}) => ({ _id: id, chat: "c1", sender: { _id: "bo" }, content: id, createdAt: "2024-01-02T10:00:00Z", readBy: ["bo"], ...extra });
+const run = (...actions) => actions.reduce(chatReducer, initialChatState);
+const loaded = (...chats) => ({ type: "chats/loaded", chats });
+const opened = (chatId, messages = []) => ({ type: "messages/loaded", chatId, messages, hasMore: false });
+
+describe("chat list", () => {
+  it("sorts by latest activity, newest first", () => {
+    const s = run(loaded(chat("old"), chat("new", { updatedAt: "2024-02-01T00:00:00Z" })));
+    expect(s.chats.map((c) => c._id)).toEqual(["new", "old"]);
+  });
+
+  it("upsert keeps our unread count when a broadcast carries none", () => {
+    const s = run(loaded(chat("c1", { unreadCount: 3 })), { type: "chat/upsert", chat: { _id: "c1", chatName: "Renamed" }, keepUnread: true });
+    expect(s.chats[0]).toMatchObject({ chatName: "Renamed", unreadCount: 3 });
+  });
+
+  it("removing a chat also drops its cached messages", () => {
+    const s = run(loaded(chat("c1")), opened("c1", [msg("m1")]), { type: "chat/removed", chatId: "c1" });
+    expect(s.chats).toEqual([]);
+    expect(s.messages.c1).toBeUndefined();
+  });
+});
+
+describe("incoming messages", () => {
+  const received = (message, countUnread) => ({ type: "message/received", message, meId: ME, countUnread });
+
+  it("counts unread only for others' messages while the chat is not being watched", () => {
+    let s = run(loaded(chat("c1")), opened("c1"), received(msg("m1"), true));
+    expect(s.chats[0].unreadCount).toBe(1);
+    s = chatReducer(s, received(msg("m2"), false)); // chat is open and visible
+    expect(s.chats[0].unreadCount).toBe(1);
+    s = chatReducer(s, received(msg("m3", { sender: { _id: ME } }), true)); // my own, from another tab
+    expect(s.chats[0].unreadCount).toBe(1);
+  });
+
+  it("ignores a duplicate delivery of the same message", () => {
+    const m = msg("m1");
+    const s = run(loaded(chat("c1")), opened("c1"), received(m, true), received(m, true));
+    expect(s.messages.c1.items).toHaveLength(1);
+    expect(s.chats[0].unreadCount).toBe(1);
+  });
+
+  it("moves the chat to the top and clears the sender's typing state", () => {
+    const s = run(
+      loaded(chat("c1", { updatedAt: "2024-01-01T00:00:00Z" }), chat("c2", { updatedAt: "2024-01-05T00:00:00Z" })),
+      { type: "typing/set", chatId: "c1", userId: "bo", name: "Bo", on: true },
+      received(msg("m1", { createdAt: "2024-02-01T00:00:00Z" }), true)
+    );
+    expect(s.chats[0]._id).toBe("c1");
+    expect(s.typing.c1).toEqual({});
+  });
+});
+
+describe("sending", () => {
+  const optimistic = { _id: "tmp-1", chat: "c1", sender: { _id: ME }, content: "hi", createdAt: "2024-01-02T10:00:00Z", status: "sending" };
+
+  it("replaces the optimistic bubble with the server message, with no duplicate when the socket echo arrives first", () => {
+    const real = msg("real", { sender: { _id: ME }, content: "hi", readBy: [ME] });
+    const s = run(
+      loaded(chat("c1")),
+      opened("c1"),
+      { type: "message/optimistic", chatId: "c1", message: optimistic },
+      { type: "message/received", message: real, meId: ME, countUnread: false },
+      { type: "message/replaced", chatId: "c1", tempId: "tmp-1", message: real, meId: ME }
+    );
+    expect(s.messages.c1.items.map((m) => m._id)).toEqual(["real"]);
+    expect(s.chats[0].unreadCount).toBe(0);
+  });
+
+  it("swaps the optimistic bubble in place when the socket echo wins the race (no flash of two bubbles)", () => {
+    const echo = msg("real", { sender: { _id: ME }, content: "hi", readBy: [ME], clientId: "tmp-1" });
+    const s = run(
+      loaded(chat("c1")),
+      opened("c1"),
+      { type: "message/optimistic", chatId: "c1", message: optimistic },
+      { type: "message/received", message: echo, meId: ME, countUnread: false }
+    );
+    expect(s.messages.c1.items.map((m) => m._id)).toEqual(["real"]);
+  });
+
+  it("marks failures, supports retry and discard", () => {
+    let s = run(loaded(chat("c1")), opened("c1"), { type: "message/optimistic", chatId: "c1", message: optimistic }, { type: "message/failed", chatId: "c1", tempId: "tmp-1" });
+    expect(s.messages.c1.items[0].status).toBe("failed");
+    s = chatReducer(s, { type: "message/retrying", chatId: "c1", tempId: "tmp-1" });
+    expect(s.messages.c1.items[0].status).toBe("sending");
+    s = chatReducer(s, { type: "message/discarded", chatId: "c1", tempId: "tmp-1" });
+    expect(s.messages.c1.items).toEqual([]);
+  });
+
+  it("keeps unsent messages when history is (re)loaded", () => {
+    const s = run(loaded(chat("c1")), opened("c1"), { type: "message/optimistic", chatId: "c1", message: { ...optimistic, status: "failed" } }, opened("c1", [msg("m1")]));
+    expect(s.messages.c1.items.map((m) => m._id)).toEqual(["m1", "tmp-1"]);
+  });
+});
+
+describe("history paging", () => {
+  it("prepends older pages without duplicating", () => {
+    const s = run(
+      loaded(chat("c1")),
+      opened("c1", [msg("m3"), msg("m4")]),
+      { type: "messages/older", chatId: "c1", messages: [msg("m1"), msg("m2"), msg("m3")], hasMore: false }
+    );
+    expect(s.messages.c1.items.map((m) => m._id)).toEqual(["m1", "m2", "m3", "m4"]);
+    expect(s.messages.c1.hasMore).toBe(false);
+  });
+});
+
+describe("read receipts, presence and typing", () => {
+  it("stamps a reader on messages they did not send", () => {
+    const mine = msg("m1", { sender: { _id: ME }, readBy: [ME] });
+    const s = run(loaded(chat("c1", { latestMessage: mine })), opened("c1", [mine]), { type: "messages/readBy", chatId: "c1", userId: "bo" });
+    expect(s.messages.c1.items[0].readBy).toEqual([ME, "bo"]);
+    expect(s.chats[0].latestMessage.readBy).toEqual([ME, "bo"]);
+  });
+
+  it("tracks who is online and when they were last seen", () => {
+    let s = run({ type: "presence/list", ids: ["bo"] });
+    expect(s.online).toEqual({ bo: true });
+    s = chatReducer(s, { type: "presence/update", userId: "bo", online: false, lastSeenAt: "2024-01-01T00:00:00Z" });
+    expect(s.online).toEqual({});
+    expect(s.lastSeen.bo).toBe("2024-01-01T00:00:00Z");
+  });
+
+  it("marking a chat read zeroes its badge", () => {
+    const s = run(loaded(chat("c1", { unreadCount: 4 })), { type: "chat/markedRead", chatId: "c1" });
+    expect(s.chats[0].unreadCount).toBe(0);
+  });
+
+  it("reset returns to the initial state (sign-out)", () => {
+    expect(run(loaded(chat("c1")), { type: "reset" })).toEqual(initialChatState);
+  });
+});
