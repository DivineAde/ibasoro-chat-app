+function Shell() {
+  const { activeChatId } = useChatState();
+  return (
+    <div className="flex h-dvh overflow-hidden bg-canvas">
+      <Sidebar
+        className={cn(
+          "w-full shrink-0 md:w-[22rem] md:border-r md:border-line lg:w-[25rem]",
+          activeChatId ? "hidden md:flex" : "flex"
+        )}
