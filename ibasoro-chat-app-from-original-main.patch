+      <main className={cn("min-w-0 flex-1 flex-col", activeChatId ? "flex" : "hidden md:flex")}>
+        <Outlet />
+      </main>
+    </div>
+  );
+}
+
+export function ChatLayout() {
+  return (
+    <ChatProvider>
+      <Shell />
+    </ChatProvider>
+  );
+}
