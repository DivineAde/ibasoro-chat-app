+/** "Joined today" / "Joined yesterday" / "Joined 5 days ago" / "Joined Oct 3". */
+export const formatJoined = (iso, now = new Date()) => {
+  if (!iso) return "";
+  const d = new Date(iso);
+  const diff = daysBetween(now, d);
